# Copy to .env and fill in real values.
# This file mirrors the root .env.example but scoped to the backend service
# (useful when running the backend outside of Docker Compose).

POSTGRES_USER=flappit
POSTGRES_PASSWORD=flappit_secret
POSTGRES_DB=flappit_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379

SECRET_KEY=change_me_to_a_long_random_string_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ENVIRONMENT=development

OPENAI_API_KEY=your_openai_api_key_here

# Maps: OpenStreetMap is used — no API key required

CORS_ORIGINS=http://localhost:3000,http://localhost:8081

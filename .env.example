# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=flappit
POSTGRES_PASSWORD=flappit_secret
POSTGRES_DB=flappit_db
POSTGRES_HOST=db          # use "localhost" when running outside Docker
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis          # use "localhost" when running outside Docker
REDIS_PORT=6379

# ── App ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_long_random_string_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ENVIRONMENT=development   # development | production

# ── Maps ──────────────────────────────────────────────────────────────────────
# OpenStreetMap is used — no API key required

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ── Frontend ──────────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:8000
